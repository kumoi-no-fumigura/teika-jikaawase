  },
  {
   "id": "gunsho08-teika-jika-0003",
   "pid": "1879502",
   "pages": [
    554
   ],
   "text": "家隆卿百番自歌合靜なる心のうちのあらましにいくたひかみしさらしなの月廿一番左夕方面まつほとはなくさむ事も有へきに涙ゆるさぬ我ゆふへかな右述懷野も山もくるしきまては尋ぬへき誰にうき世の外をとはまし廿二番左冬戀雲そうき色にはみせぬわか袖もしくると人にしらせぬる哉右山路いかにしてこゆへき道の末なれは雲にひとしき山のみゆらん廿三番左曉別戀しはしともとまりかたしや啼鳥の別れを告るこゑ〓〓の里右山家世中のうかりし宿をおもふには深きも淺き山の奥かな廿四番左社頭鐘今はとてもよふす鐘の男山神代の月の明方のそら左社頭松神かきにみつのくらゐやをくるらん雲ゐの風のかよふ松かな爲家卿自筆之以本書寫畢。文龜二年臘月念二日亥國在判右定家卿丗八首自歌合一卷以濵田侯秘藏古鈔本書寫畢",
   "poems": [
    "39",
    "40",
    "41",
    "42",
    "43",
    "44",
    "45",
    "46",
    "47"
   ],
   "lb": []
  }
 ],
 "poems": [
  {
   "seq": "1",
   "text": "春さむき梢は雪にうつもれてさかぬもまかふ軒の梅か枝",
   "kana": "",
   "speaker": "",
   "page": 553,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "2",
   "text": "浦人のあしわけを舟こき出てさはるかたなくかすむ春哉",
   "kana": "",
   "speaker": "",
   "page": 553,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "3",
   "text": "蜑人のたつる烟は見えわかて霞そ春のもしほやきける",
   "kana": "",
   "speaker": "",
   "page": 553,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "4",
   "text": "時しらぬ花の雪降此ころはよしのも富士の山と見えけり",
   "kana": "",
   "speaker": "",
   "page": 553,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "5",
   "text": "かつらきやとよらの櫻咲にけりかすみの西にかゝるらし雲",
   "kana": "",
   "speaker": "",
   "page": 553,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "6",
   "text": "すゑにみし雲を心に分とめて花にさたむる春の山越",
   "kana": "",
   "speaker": "",
   "page": 553,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "7",
   "text": "尋入山ちやふかくなりぬらん跡より送るはなの下風",
   "kana": "",
   "speaker": "",
   "page": 553,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "8",
   "text": "山まとをさひしき物と思ひしは花みぬほとの心なりけり",
   "kana": "",
   "speaker": "",
   "page": 553,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "9",
   "text": "遠しまの一木の松にゐる雲をはなかとみてや歸る雁かね",
   "kana": "",
   "speaker": "",
   "page": 553,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "10",
   "text": "大非河みきはもしろく花ちれは春も枯たるあしの村立",
   "kana": "",
   "speaker": "",
   "page": 553,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "11",
   "text": "おほろなるならひをかこつ春のよの雨さへかすむ有明のはて",
   "kana": "",
   "speaker": "",
   "page": 553,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "12",
   "text": "名殘なく心もつきてかなしきは今を限りの入相の鐘",
   "kana": "",
   "speaker": "",
   "page": 553,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "13",
   "text": "みちのへの杜のこずゑの郭公またぬになのる雨のたそかれ",
   "kana": "",
   "speaker": "",
   "page": 553,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "14",
   "text": "夏なからこゆると見えて月影の凉しく下るうちの川舟",
   "kana": "",
   "speaker": "",
   "page": 553,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "15",
   "text": "庭しけき草葉の下の道たえてとはぬ人めは夏もかれけり",
   "kana": "",
   "speaker": "",
   "page": 553,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "16",
   "text": "夕立のむかはんかたは峯晴て日かけ分たる遠山の色",
   "kana": "",
   "speaker": "",
   "page": 553,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "17",
   "text": "しけりそふ庭の木かけの夕露にみさりし秋をさそふかせかな",
   "kana": "",
   "speaker": "",
   "page": 553,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "18",
   "text": "はつ秋の雲間のやまの雨そゝきはるればすゝし三日月のかけ",
   "kana": "",
   "speaker": "",
   "page": 553,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "19",
   "text": "むら雲の月にわかるゝ山かつらかけはなれてもすめろ月哉",
   "kana": "",
   "speaker": "",
   "page": 553,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "20",
   "text": "吹かへすあらしにさよや更ぬらん雲にちかひてすめろ月影",
   "kana": "",
   "speaker": "",
   "page": 553,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "21",
   "text": "あれわたる軒の板まの影もりて月さへこけの衣きてけり",
   "kana": "",
   "speaker": "",
   "page": 553,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "22",
   "text": "深き夜の山路の月のをくらすはつらかりぬへき旅のそらかな",
   "kana": "",
   "speaker": "",
   "page": 553,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "23",
   "text": "をのつから山ちの末にわけ出て月にむかへは明る空かな",
   "kana": "",
   "speaker": "",
   "page": 553,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "24",
   "text": "月の行かきりもさらにしら浪のまねきもとめぬまつらさよ姫",
   "kana": "",
   "speaker": "",
   "page": 553,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "25",
   "text": "いさりひの烟きよみの浦風に月より外はよる波もなし",
   "kana": "",
   "speaker": "",
   "page": 553,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "26",
   "text": "さやかなる秋もこよひの中空に雲をはみせぬ月の影かな",
   "kana": "",
   "speaker": "",
   "page": 553,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "27",
   "text": "うき事をわすれてそみる秋の月なみたのひまやこよひ成らん",
   "kana": "",
   "speaker": "",
   "page": 553,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "28",
   "text": "衣うつうらの笘やに秋ふけてよさむに成ぬ八重の鹽風",
   "kana": "",
   "speaker": "",
   "page": 553,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "29",
   "text": "ゆく秋の尾花か袖は月もなしをのいそ殘る露のほの〓〓",
   "kana": "",
   "speaker": "",
   "page": 553,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "30",
   "text": "風こしの峯たちのほるうき雲を時雨のうへや月のかけはし",
   "kana": "",
   "speaker": "",
   "page": 553,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "31",
   "text": "里まてはをくらぬ雲のと絕にて遠山はかりみゆる初雪",
   "kana": "",
   "speaker": "",
   "page": 553,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "32",
   "text": "行なやみあらしに宿をかるもかく猪なのゝ雪のさむき夕暮",
   "kana": "",
   "speaker": "",
   "page": 553,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "33",
   "text": "旅人のかりれの床に雪つみてたゝひと夜なる冬こもり哉",
   "kana": "",
   "speaker": "",
   "page": 553,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "34",
   "text": "跡おしむならひもしらし降雪のつもらぬなみにかよふ舟人",
   "kana": "",
   "speaker": "",
   "page": 553,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "35",
   "text": "くれ竹の窓のひまもる山風に人もあつめぬ雪のさむけさ",
   "kana": "",
   "speaker": "",
   "page": 553,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "36",
   "text": "いつはりに過しは夢の日數にてこよひそむかふ袖の俤",
   "kana": "",
   "speaker": "",
   "page": 553,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "37",
   "text": "草枕一夜のなこり跡たえて明るをいそく夢の山越",
   "kana": "",
   "speaker": "",
   "page": 553,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "38",
   "text": "うらみ侘おもひたえにしその比の月にむかへはうかむ佛",
   "kana": "",
   "speaker": "",
   "page": 553,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "39",
   "text": "靜なる心のうちのあらましにいくたひかみしさらしなの月",
   "kana": "",
   "speaker": "",
   "page": 554,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "40",
   "text": "まつほとはなくさむ事も有へきに涙ゆるさぬ我ゆふへかな",
   "kana": "",
   "speaker": "",
   "page": 554,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "41",
   "text": "野も山もくるしきまては尋ぬへき誰にうき世の外をとはまし",
   "kana": "",
   "speaker": "",
   "page": 554,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "42",
   "text": "雲そうき色にはみせぬわか袖もしくると人にしらせぬる哉",
   "kana": "",
   "speaker": "",
   "page": 554,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "43",
   "text": "いかにしてこゆへき道の末なれは雲にひとしき山のみゆらん",
   "kana": "",
   "speaker": "",
   "page": 554,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "44",
   "text": "しはしともとまりかたしや啼鳥の別れを告るこゑ〓〓の里",
   "kana": "",
   "speaker": "",
   "page": 554,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "45",
